__pycache__/
*.pyc

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# Backup and interaction-log artifacts (local-only, Phase 7 hygiene)
.beads.backup-pre-recovery/
.beads/interactions.jsonl
*.bak

# Stripped from history in Phase 7 (git filter-repo) — must never re-enter tracking
.beads/config.yaml
.beads/metadata.json

# Runtime copy of the bd prime override (D-08) — the tracked source is
# plugins/beads-lifecycle/.agents/skills/beads/PRIME.md; this copy is regenerated by the
# SessionStart hook.
.beads/PRIME.md

# Local tool state (per-machine, not shared across clones)
.serena/

# Project-scope capability install destination (per-machine runtime overlay) plus staging
# and dispatch state — gsd-core's capability loader always installs project-scope bundles to
# <projectRoot>/.gsd/capabilities/<id>/, copied from a plugin's own tracked source tree
# (e.g. plugins/beads-lifecycle/.gsd/capabilities/beads/); never track the copy here again.
.gsd/
