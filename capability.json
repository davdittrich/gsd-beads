{
  "id": "beads",
  "role": "feature",
  "version": "0.9.3",
  "taskContentResolver": {
    "trackerPrefix": "beads",
    "invoke": {
      "binary": "python3",
      "args": ["-Ic", "import os,sys;from pathlib import Path;g=os.environ.get('GSD_HOME','');root=Path(g) if os.path.isabs(g) else Path.home();root.is_absolute() or sys.exit('gsd-beads: no absolute GSD_HOME or HOME');root.is_absolute() or sys.exit('gsd-beads: no absolute GSD_HOME or HOME');script=root/'.gsd'/'capabilities'/'beads'/'scripts'/'sync.py';os.execv(sys.executable,[sys.executable,'-I',str(script),\"resolve-task-content\", sys.argv[1]])", "{{id}}"],
      "timeoutMs": 10000
    }
  },
  "title": "Beads issue tracking",
  "description": "Beads is the task substrate: gsd plan tasks exist as beads issues, their status lives in beads.",
  "tier": "full",
  "requires": [],
  "engines": {
    "gsd": ">=1.11.0"
  },
  "runtimeCompat": {
    "supported": [
      "*"
    ],
    "unsupported": []
  },
  "skills": [
    "beads-sync",
    "beads-status",
    "beads-close",
    "beads-recall",
    "beads-migrate-todos"
  ],
  "agents": [],
  "hooks": [],
  "config": {
    "beads.enabled": {
      "type": "boolean",
      "default": true,
      "description": "Master toggle for the beads issue-tracking capability."
    },
    "beads.sync_mode": {
      "type": "enum",
      "values": [
        "authoritative",
        "mirror"
      ],
      "default": "authoritative",
      "description": "Governs whether an explicit `sync.py create-issues <plan>` strips synced <task> bodies out of PLAN.md. authoritative (default): strips because native task resolution reads authoritative content from bd after first sync, and PLAN.md task text is never re-synced from later bd edits. mirror: never strips -- PLAN.md keeps every task body. Neither value governs the hook-driven plan:post dispatch, which never strips."
    },
    "beads.ship_gate": {
      "type": "boolean",
      "default": true,
      "description": "When true, ship:pre blocks when blocking_open or diverged is not 0 (unknown counts) in BEADS.md."
    },
    "beads.epic_per": {
      "type": "enum",
      "values": [
        "phase",
        "milestone"
      ],
      "default": "phase",
      "description": "phase (default): one epic per phase, as today. milestone: one epic shared across every phase in the current milestone. Forward-only: existing per-phase epics are not folded in. Read fresh at each epic creation."
    }
  },
  "steps": [
    {
      "point": "plan:pre",
      "ref": {
        "skill": "beads-recall"
      },
      "produces": [
        "BEADS-RECALL.md"
      ],
      "consumes": [
        "CONTEXT.md"
      ],
      "when": "beads.enabled",
      "onError": "skip"
    },
    {
      "point": "plan:post",
      "ref": {
        "skill": "beads-sync"
      },
      "produces": [
        "PLAN.md"
      ],
      "consumes": [
        "PLAN.md"
      ],
      "when": "beads.enabled",
      "onError": "skip"
    },
    {
      "point": "execute:wave:pre",
      "ref": {
        "skill": "beads-status"
      },
      "produces": [
        "BEADS.md"
      ],
      "consumes": [
        "PLAN.md"
      ],
      "when": "beads.enabled",
      "onError": "skip"
    },
    {
      "point": "execute:wave:post",
      "ref": {
        "skill": "beads-status"
      },
      "produces": [
        "BEADS.md"
      ],
      "consumes": [
        "PLAN.md"
      ],
      "when": "beads.enabled",
      "onError": "skip"
    },
    {
      "point": "verify:post",
      "ref": {
        "skill": "beads-status"
      },
      "produces": [
        "BEADS.md"
      ],
      "consumes": [
        "UAT.md"
      ],
      "when": "beads.enabled",
      "onError": "skip"
    },
    {
      "point": "verify:post",
      "ref": {
        "skill": "beads-close"
      },
      "produces": [],
      "consumes": [],
      "when": "beads.enabled",
      "onError": "skip"
    },
    {
      "point": "ship:pre",
      "ref": {
        "skill": "beads-status"
      },
      "produces": [],
      "consumes": [
        "BEADS.md"
      ],
      "when": "beads.enabled",
      "onError": "skip"
    },
    {
      "point": "ship:pre",
      "ref": {
        "skill": "beads-close"
      },
      "produces": [],
      "consumes": [
        "BEADS.md"
      ],
      "when": "beads.enabled",
      "onError": "skip"
    }
  ],
  "contributions": [
    {
      "point": "plan:pre",
      "into": "planner",
      "produces": [],
      "consumes": [
        "BEADS-RECALL.md"
      ],
      "fragment": {
        "path": "fragments/recall-pointer.md"
      },
      "when": "beads.enabled",
      "onError": "skip"
    }
  ],
  "gates": [
    {
      "point": "ship:pre",
      "check": {
        "predicate": {
          "kind": "artifact-frontmatter-equals",
          "artifact": "BEADS.md",
          "field": "blocking_open",
          "equals": 0
        }
      },
      "when": "beads.ship_gate",
      "blocking": true,
      "onError": "halt"
    },
    {
      "point": "ship:pre",
      "check": {
        "predicate": {
          "kind": "artifact-frontmatter-equals",
          "artifact": "BEADS.md",
          "field": "diverged",
          "equals": 0
        }
      },
      "when": "beads.ship_gate",
      "blocking": true,
      "onError": "halt"
    }
  ]
}
